# ==============================================================================
# NETWORK MONITOR CONFIGURATION
# ==============================================================================
# Welcome! To set up email alerts, you need to provide your email credentials below.
# If you are using Gmail, you MUST use an "App Password" instead of your normal password.
# 
# How to get a Gmail App Password:
# 1. Go to your Google Account -> Security.
# 2. Enable "2-Step Verification" if it isn't already.
# 3. Search for "App Passwords" in your account settings.
# 4. Create a new App Password (call it "Network Monitor") and paste the 16-letter code below.
# ==============================================================================

# --- 1. Email Credentials ---
# Type your full email address here (e.g., yourname@gmail.com)
SMTP_USERNAME=""

# Type your 16-letter Gmail App Password here (no spaces, e.g., abcdfeghijklmnop)
SMTP_PASSWORD=""

# --- 2. Where should we send the alerts? ---
# Type the email address that should receive the alerts. 
# (You can just put your own email address again to send it to yourself)
ALERT_EMAIL_TO=""

# --- 3. Advanced Network Settings (Optional) ---
# The monitor will automatically detect your network interface and subnet.
# Only change these if the auto-detection fails.
# INTERFACE="eth0"
# NETWORK_SUBNET="192.168.1.0/24"

# --- 4. Data Limits ---
# Limit 1: When a device exceeds this limit, an EMAIL ALERT is sent. (Default: 1 GB)
DATA_LIMIT_ALERT_BYTES=1073741824

# Limit 2: When a device exceeds this limit, it is BLOCKED. (Default: 3 GB)
DATA_LIMIT_BLOCK_BYTES=3221225472
